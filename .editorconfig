root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.kts]
indent_style = tab
tab_width = 4

[*.java]
indent_style = space
indent_size = 2

[*.{yaml,yml,json,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
